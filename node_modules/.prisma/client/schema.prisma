generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  PRACTITIONER
  SALES_EXECUTIVE
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(CLINIC_ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  practitioner  Practitioner?
  patient       Patient?
  userBranches  UserBranch[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  subscriptions Subscription[]

  @@map("clinics")
}

model Branch {
  id            String   @id @default(uuid())
  clinicId      String?
  name          String
  joinDate      String?
  email         String?
  phone         String?
  address       String?
  timezone      String   @default("AEDT")
  businessHours Json?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  userBranches UserBranch[]
  appointments Appointment[]

  @@map("branches")
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Practitioner {
  id               String   @id @default(uuid())
  userId           String?  @unique
  name             String
  specialty        String
  color            String   @default("#8C4BFF")
  email            String   @unique
  phone            String?
  status           String   @default("Active")
  joinDate         String?
  assignedBranches Json?
  qualifications   Json?
  bio              String?  @db.Text
  consultationFee  Float    @default(0.0)
  availability     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@map("practitioners")
}

model Patient {
  id                    String   @id @default(uuid())
  userId                String?  @unique
  fullName              String
  dob                   String?
  gender                String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  postcode              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicareNumber        String?
  ndisNumber            String?
  privateHealthFund     String?
  notes                 String?  @db.Text
  sessionsUsed          Int      @default(0)
  sessionsAllocated     Int      @default(10)
  status                String   @default("active")
  tags                  Json?
  diagnosis             Json?
  alerts                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  invoices     Invoice[]

  @@map("patients")
}

model Waitlist {
  id                    String   @id @default(uuid())
  clientName            String
  dob                   String?
  contactNumber         String?
  address               String?
  preferredPractitioner String?
  preferredDate         String?
  dateAdded             String?
  appointmentType       String?  @default("Initial Assessment")
  status                String   @default("Waiting")
  branch                String?
  createdAt             DateTime @default(now())

  @@map("waitlists")
}

model Appointment {
  id               String   @id @default(uuid())
  patientId        String?
  patientName      String
  practitionerId   String?
  practitionerName String
  branchId         String?
  branchName       String?
  serviceName      String?
  date             String
  startTime        String
  endTime          String
  status           String   @default("Scheduled")
  location         String?  @default("Melbourne Clinic")
  room             String?  @default("Room A")
  notes            String?  @db.Text
  fee              Float    @default(0.0)
  isPaid           Boolean  @default(false)
  travelDetails    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  patientId     String?
  patientName   String
  issueDate     String
  dueDate       String
  amount        Float    @default(0.0)
  due           Float    @default(0.0)
  status        String   @default("Draft")
  sentStatus    String   @default("Not Sent")
  items         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

model SalesLead {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  phone         String?
  status        String   @default("New")
  value         Float    @default(0.0)
  assignedTo    String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sales_leads")
}

model Subscription {
  id              String   @id @default(uuid())
  clinicId        String?
  clinicName      String
  plan            String
  billingCycle    String   @default("Monthly")
  amount          Float
  status          String   @default("Active")
  nextBillingDate String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@map("subscriptions")
}

model FormTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String   @default("Assessment")
  lastModified String
  createdAt    DateTime @default(now())

  @@map("form_templates")
}

model LetterTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String   @default("Referrals")
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@map("letter_templates")
}

model NoteTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("note_templates")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  userRole  String?
  action    String
  module    String
  details   String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
